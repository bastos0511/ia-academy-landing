    },
    {
      "parameters": {
        "jsCode": "// Arma el aviso de Telegram con los datos del registro que se acaba de guardar\nconst r = $input.first().json;\nconst esc = t => String(t ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst fecha = new Date(r.creado_en).toLocaleString('es-CO', { timeZone: 'America/Bogota', dateStyle: 'medium', timeStyle: 'short' });\nconst lineas = [\n  '🚀 <b>Nueva solicitud · AI Academy</b>',\n  '',\n  `<b>Nombre:</b> ${esc(r.nombre)}`,\n  `<b>Correo:</b> ${esc(r.correo)}`,\n  `<b>Programa:</b> ${esc(r.programa)}`\n];\nif (r.telefono) lineas.push(`<b>Teléfono:</b> ${esc(r.telefono)}`);\nlineas.push('', `Registro #${r.id} · Estado: ${esc(r.estado)} · ${esc(fecha)}`);\nreturn [{ json: { id: r.id, mensaje: lineas.join('\\n') } }];"
      },
