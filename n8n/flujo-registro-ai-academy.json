    {
      "parameters": {
        "jsCode": "// Valida y normaliza los datos del formulario. Si algo es inválido, no se guarda ni se avisa.\nconst PROGRAMAS = ['Ignition (4 h)', 'Booster (8 h)', 'Liftoff (12 h)', 'Odyssey (personalizado)', 'Nebula (pregrabado)', 'Aún no sé, quiero asesoría'];\nconst b = $input.first().json.body || {};\nconst s = v => (typeof v === 'string' ? v : '').trim();\nconst datos = {\n  nombre: s(b.nombre).replace(/\\s+/g, ' '),\n  correo: s(b.correo).toLowerCase(),\n  programa: s(b.programa),\n  telefono: s(b.telefono),\n  origen: s(b.origen) || 'landing'\n};\nconst errores = {};\nif (datos.nombre.length < 3 || datos.nombre.length > 80 || /[0-9<>]/.test(datos.nombre)) errores.nombre = 'Escribe tu nombre completo (mínimo 3 letras, sin números).';\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(datos.correo) || datos.correo.length > 120) errores.correo = 'Escribe un correo válido.';\nif (!PROGRAMAS.includes(datos.programa)) errores.programa = 'Elige un programa de la lista.';\nif (datos.telefono) {\n  const digitos = datos.telefono.replace(/[\\s()+-]/g, '');\n  if (!/^\\d{7,15}$/.test(digitos)) errores.telefono = 'Si escribes el teléfono, usa solo números (7 a 15 dígitos).';\n}\nif (s(b.empresa_web)) errores.bot = 'Envío rechazado.';\nreturn [{ json: { valido: Object.keys(errores).length === 0, errores, datos } }];"
      },
      "id": "1e7ddd09-c48c-4400-909a-34e154862368",
